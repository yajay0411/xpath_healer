# Local stack: cd ../next_login && supabase status
# Cloud: Project Settings -> API Keys (use the SECRET key, never the publishable one)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Any long random string. Jenkins sends it as the X-Webhook-Secret header.
JENKINS_WEBHOOK_SECRET=

# --- healing workflow -------------------------------------------------------
# Local build-out needs no account and no tunnel:  npm run inngest
# INNGEST_DEV=1 tells the SDK to talk to that local dev server instead of Inngest Cloud.
# Unset it (and set the two keys) only when you move to Cloud.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The kill switch. "false" stops every new run at STEP A.
HEALER_ENABLED=true
# Comma-separated. A repo not named here is skipped, never healed.
HEAL_ALLOWED_REPOS=yajay0411/next_login_javatestcase
HEAL_BASE_BRANCH=main

# --- verification: Jenkins is the executor, not this process ----------------
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_VERIFY_JOB=heal-verify
HEAL_VERIFY_TIMEOUT=30m

# --- model: only used when the deterministic pass finds nothing -------------
# anthropic | groq | xai | openai | local
LLM_PROVIDER=anthropic
HEAL_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Groq supports json_schema only on openai/gpt-oss-* and qwen/qwen3.8-27b.
# HEAL_MODEL=openai/gpt-oss-120b  (HEAL_PRICE_INPUT=0.15 HEAL_PRICE_OUTPUT=0.60)
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# LOCAL_LLM_URL=http://localhost:11434/v1
# Non-Anthropic providers have no built-in price table. Without these the USD cap
# cannot bind and the adapter says so at runtime; the daily run cap still applies.
# HEAL_PRICE_INPUT=
# HEAL_PRICE_OUTPUT=

HEAL_MAX_USD_PER_DAY=5
HEAL_MAX_RUNS_PER_DAY=10

# --- github ----------------------------------------------------------------
# Fine-grained PAT scoped to ONE repo: contents:write + pull_requests:write, nothing else.
GITHUB_TOKEN=

# --- optional --------------------------------------------------------------
# The XPath gate drives the system Chrome. Set only if it is somewhere unusual.
# CHROME_PATH=
