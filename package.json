{
  "name": "xh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "check": "npm run check:normalize && npm run check:heal",
    "check:normalize": "node --no-warnings --experimental-strip-types scripts/check-normalize.mts",
    "check:heal": "node --no-warnings --experimental-strip-types scripts/check-heal.mts",
    "inngest": "npx inngest-cli@latest dev -u http://localhost:3002/api/inngest",
    "typecheck": "tsc --noEmit",
    "check:gates": "node --no-warnings --experimental-strip-types scripts/check-gates.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/supabase-js": "^2.112.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.18.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "playwright-core": "^1.62.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@inngest/eslint-plugin": "^0.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
